datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Metric {
  id        String   @id @default(cuid())
  moduleId  String
  key       String
  value     String
  status    String   @default("NORMAL")
  updatedAt DateTime @updatedAt
}

model OperationalLog {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  description String
  category    String
  severity    String   @default("INFO")
  createdAt   DateTime @default(now())
}

model Employee {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  name        String
  department  String
  shift       String
  status      String   @default("CLOCK_IN")
}

model AndonAlert {
  id        String   @id @default(cuid())
  alertId   String   @unique
  station   String
  issue     String
  duration  String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
}
